# Copy to .env and fill in only what you actually use. .env is git-ignored.
#
# NO API KEYS OR TOKENS GO IN THIS FILE, AND NO MODEL ENDPOINTS EITHER. Every
# provider credential is entered on the dashboard settings page (Settings →
# Credentials); the local model endpoints are entered there too (Settings →
# Engine for chat, Settings → Embedding for the embedder). Both live in
# ~/.next-signal/, which the pipeline reads at call time — so a value saved
# there reaches a running scheduler with no restart and no `--force-recreate`.
# Nothing in next-signal reads a credential or a local endpoint from the
# environment; a value left here is inert.
#
# What remains below is system connection config and deployment settings. For the
# Docker stack every one of them has a default, so `docker compose up` works with
# no .env file at all.

# --- Database ---
DATABASE_URL=postgresql://localhost:5432/next_signal

# --- LLM provider endpoints (keys live in Settings → Credentials) ---
# DEEPSEEK_BASE_URL=          # optional; defaults to https://api.deepseek.com

# --- Optional coding-agent CLIs ---
# Executable overrides when the locally installed CLIs are not on PATH.
# Authentication remains in each CLI's saved login; these are not API keys.
# CODEX_BIN=/absolute/path/to/codex
# CLAUDE_BIN=/absolute/path/to/claude
# The official Docker image installs these exact releases. Upgrade deliberately
# by changing a value and rebuilding; containers never auto-update the CLIs.
CODEX_CLI_VERSION=0.145.0
CLAUDE_CODE_VERSION=2.1.220

# --- Info-radar (folocli) ---
# The Folo token is a credential: Settings → Credentials, where "Sign in to Folo"
# fetches one for you. folocli's own `~/.folo/config.json` session is NOT used.
#
# Override folocli launcher (default: ["npx", "--yes", "folocli@0.0.5"]).
# Space-separated. Example to use a globally installed binary:
#   FOLO_CLI_ARGV=folo
# FOLO_CLI_ARGV=

# Timezone for /radar day grouping and recap ranges (default America/Los_Angeles):
# INFO_RADAR_TIMEZONE=America/Los_Angeles

# --- Runtime ---
AGENTOS_PORT=7777
DASHBOARD_URL=http://localhost:3000
# Dashboard binds to loopback by default because it can start provider login.
# Set another address only behind an authenticated reverse proxy.
DASHBOARD_BIND_ADDRESS=127.0.0.1
NEXT_SIGNAL_LOG_LEVEL=INFO

# Override default state location (~/.next-signal):
# NEXT_SIGNAL_STATE_DIR=

# Override agent-staged input files location (defaults to $NEXT_SIGNAL_STATE_DIR/agent-tmp):
# NEXT_SIGNAL_AGENT_TMP_DIR=

# --- Knowledge wiki (optional; Compose falls back to repo-relative dirs) ---
# Absolute HOST paths to your Obsidian wiki repo and its raw-archive sibling.
# Leave blank and `docker compose up` mounts ./state/wiki and ./state/wiki-raw,
# so a fresh clone starts with no edits to this file. Set them to point at your
# own vault instead.
#
# This default is consumed by Compose when it builds the bind mount, never by
# the application: inside a container WIKI_DIR is always /wiki, and the code
# itself still has no default and fails loud when the variable is unset.
WIKI_DIR=
WIKI_RAW_DIR=

# GBrain CLI binary path (only when `gbrain` is not on PATH):
# GBRAIN_BIN=

# OpenCLI entrypoint for WeChat article download — main.js path or wrapper
# script. Required for wechat-source knowledge ingest.
# OPENCLI_BIN=

# Whisper model for bilibili audio transcription fallback (default: base):
# WHISPER_MODEL=

# Preferred YouTube transcript languages, comma-separated (falls back to en):
# YOUTUBE_TRANSCRIPT_LANGS=

# GBrain home + dedicated Postgres URL. Dual purpose:
# - Isolated GBrain home for integration / full-flow tests
#   (uv run next-signal knowledge init-test-gbrain): GBRAIN_HOME=state/test-gbrain
# - Containerized deployment: docker-compose.yml sets both to wire gbrain's
#   Postgres engine (see docs/containerized-deployment.md)
# GBRAIN_HOME=state/test-gbrain
# GBRAIN_DATABASE_URL=       # optional dedicated Postgres URL for GBrain
